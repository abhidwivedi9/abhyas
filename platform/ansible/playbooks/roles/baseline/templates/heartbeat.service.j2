[Unit]
Description=Heartbeat demo service (Milestone 1 scenario target)
After=network.target
# Restart-limiting belongs in [Unit], not [Service] (a common mistake —
# systemd silently ignores it in the wrong section rather than erroring).
# NOTE: observed NOT to trigger a terminal `failed` state inside this
# containerized systemd even correctly placed (NRestarts climbs
# indefinitely) — a platform quirk, not a scenario bug. Scenario grading
# does not depend on ever reaching `failed`; don't assume it in new
# scenarios without verifying live first.
StartLimitIntervalSec=10
StartLimitBurst=5

[Service]
Type=simple
User=heartbeat
ExecStart=/usr/bin/python3 /opt/heartbeat/heartbeat.py
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
